# Copy to .env and fill in. .env is never committed.

# --- Supabase Postgres -------------------------------------------------------------
# Use the "Session pooler" string from the Supabase dashboard (Connect button):
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# The "Direct connection" string (db.<project-ref>.supabase.co) is IPv6-only on the free
# plan and does not resolve from an IPv4-only network.
# Percent-encode reserved characters in the password (& # ? space).
# Leave unset to work against the local store only.
SUPABASE_DB_URL=

# --- Tracker -----------------------------------------------------------------------
# Brand whose Best Buy laptops define the baseline spec groups.
ANCHOR_BRAND=Lenovo
# Minimum pause between requests to Best Buy, in seconds.
REQUEST_DELAY_SECONDS=1.0
# A group is tracked when it has the anchor brand plus at least this many other brands.
MIN_COMPETITORS=1
# Featured groups: how many, and how many other brands each must have.
FEATURED_COUNT=10
FEATURED_MIN_COMPETITORS=2

# --- Optional ----------------------------------------------------------------------
# ShopSavvy Data API key (ss_live_...). Enables backfill_history.py --source shopsavvy.
SHOPSAVVY_API_KEY=
# Where the local store lives (default: ./data).
# TRACKER_DATA_DIR=
# Override the Best Buy gateway URL.
# BESTBUY_GRAPHQL_URL=https://www.bestbuy.com/gateway/graphql
